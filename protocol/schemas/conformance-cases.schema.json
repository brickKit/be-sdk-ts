{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brickKit/be-protocol/schemas/conformance-cases.schema.json",
  "title": "Conformance case catalogue",
  "type": "object",
  "required": ["protocol", "profiles", "cases"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "when"], "additionalProperties": false,
        "properties": { "name": { "$ref": "#/$defs/profile" }, "when": { "type": "string" } }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "profile", "level", "tests", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CP-(CORE|OBS|ERR|AUTH|SCOPE|RPC|OUT|EVP|EVS|IDEM|DB|JOBS|LIFE|BLOB|SHELL)-[0-9]{2}$" },
          "profile": { "$ref": "#/$defs/profile" },
          "level": { "enum": ["MUST", "SHOULD"] },
          "skippable": { "type": "boolean", "default": false },
          "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^P([1-9]|1[0-9]|20)\\.[1-9][0-9]*$" } },
          "title": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "profile": { "enum": ["core", "obs", "err", "auth", "scope", "grpc", "outbound", "events-pub", "events-sub", "idempotency", "db", "jobs", "lifecycle", "blob", "shell"] }
  }
}
